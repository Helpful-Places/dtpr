    website: "https://helpfulplaces.com/"
repository-code: "https://github.com/helpful-places/dtpr"
url: "https://dtpr.io"
license: CC-BY-4.0
version: 0.1.0
date-released: 2026-05-11
keywords:
  - digital transparency
  - AI transparency
  - algorithmic accountability
  - public realm
  - data ethics
  - taxonomy
  - DTPR
identifiers:
