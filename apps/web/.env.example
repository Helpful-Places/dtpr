# Local development secrets for Nuxt Studio.
# Copy to `.env` and fill in real values. `.env` is gitignored.
# `nuxt dev` (via `pnpm dev:web`) loads this file automatically.
# For production, each of these is set via
# `npx wrangler secret put <NAME> --profile helpfulplaces` (or `secret bulk`).
#
# Note: if you run the production build locally via `npx wrangler dev`, copy this to `.dev.vars` instead
# (also gitignored). That path is rarely needed — prefer `nuxt dev`.

# --- Session signing (REQUIRED in production) ---
# Overrides runtimeConfig.studio.auth.sessionSecret, which nuxt-studio otherwise
# derives at BUILD time from values that are empty in a Workers deploy — the
# baked-in default is md5("") = d41d8cd98f00b204e9800998ecf8427e, a known
# constant that would let anyone forge a studio-session cookie.
# Generate with: openssl rand -hex 32
NUXT_STUDIO_AUTH_SESSION_SECRET=

# --- Google OAuth (non-technical editors) ---
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
# Comma-separated list of Google email addresses allowed into the editor UI.
# No spaces after commas — the module does a bare .split(",") with no trimming.
# Empty = nobody gets in (fails closed). This list is the ONLY thing gating
# repo write access on the Google path, since those commits use the bot PAT.
STUDIO_GOOGLE_MODERATORS=

# --- GitHub OAuth (developer editors; commits authored under signed-in user) ---
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# Comma-separated list of GitHub emails allowed into the editor UI.
# MUST be kept in sync with STUDIO_GOOGLE_MODERATORS.
# WARNING: empty = EVERYONE gets in (fails open, unlike the Google check).
STUDIO_GITHUB_MODERATORS=

# --- Bot PAT (used only for Google-OAuth-path commits) ---
# Fine-grained PAT scoped to helpful-places/dtpr
# with Contents: Read and write.
STUDIO_GITHUB_TOKEN=

# --- Feature flags (public; off unless set) ---
# The datachain builder: the Build view, "Add to datachain" on elements, and
# every link to /taxonomy/builder. Set to true on a preview to try it.
# NUXT_PUBLIC_FEATURES_BUILDER=true
