{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dtpr-web",
  "account_id": "f978769622a3e15ad770688a80811aa8",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // dtpr.io is the site. The others are hosts it replaced or aliases, and
  // server/middleware/legacy-redirects.ts sends them on to dtpr.io. Workers
  // Builds deploys these as the Worker's complete set of custom domains: one
  // missing here is detached on the next deploy. A deploy moves a hostname off
  // another Worker, but fails if it has an ordinary DNS record (A, CNAME, ...);
  // delete that record first, then deploy.
  "routes": [
    { "pattern": "dtpr.io", "custom_domain": true },
    { "pattern": "www.dtpr.io", "custom_domain": true },
    { "pattern": "dev.dtpr.io", "custom_domain": true },
    { "pattern": "docs.dtpr.io", "custom_domain": true },
    { "pattern": "dtpr.ai", "custom_domain": true },
    { "pattern": "www.dtpr.ai", "custom_domain": true }
  ],
  "preview_urls":true,
  
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtpr-web-content",
      "database_id": "2a479576-88c6-40d3-b21a-f6909e4fd9c2"
    }
  ],
  // Previews (`wrangler preview`, run by Workers Builds on non-production
  // branches) don't inherit production bindings. They get their own D1 so a
  // preview's content dump never overwrites the one dtpr.io reads.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "dtpr-web-content-preview",
        "database_id": "bf0b4f66-5eb3-4860-bdbc-4da504d9ea97"
      }
    ]
  },
  "observability": { "enabled": true }
}
